source "https://rubygems.org"

# Pulls in whatever Jekyll/theme/plugin versions GitHub Pages actually runs in
# production (this is what makes the `minima` theme gem available at all -
# without it, `bundle exec jekyll build` fails with "File to import not
# found or unreadable: minima" because assets/main.scss's `@import "minima";`
# has nothing to resolve against). Using this gem instead of pinning `jekyll`
# and `minima` directly means a local preview here matches exactly what will
# render once this manual is copied into the serafintech.github.io repo (see
# _config.yml's publishing notes), rather than drifting out of sync with it.
gem "github-pages", group: :jekyll_plugins

# Windows/JRuby don't ship IANA time zone data - only needed on those platforms.
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end
